# PostgreSQL
POSTGRES_DB=nvn_database
POSTGRES_USER=nvn_operator
POSTGRES_PASSWORD=change_me_please

# 管理画面/API の Basic 認証
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me_admin_password

# 週次イベント自動作成のスケジュール
# AUTO_WEEKLY_DAY_OF_WEEK: 0=Sunday ... 6=Saturday（または Wednesday など英語名）
AUTO_WEEKLY_TIMEZONE=Asia/Tokyo
AUTO_WEEKLY_DAY_OF_WEEK=Wednesday
AUTO_WEEKLY_HOUR=21
AUTO_WEEKLY_MINUTE=0
AUTO_WEEKLY_DURATION_HOURS=168

# scheduler コンテナが API を叩く時刻（Linux cron 書式）
# 毎日 00:05 に実行し、API 側が次回開催枠の作成可否を判定する
AUTO_WEEKLY_TRIGGER_CRON=5 0 * * *

# nginx の外部公開ポート
# Windows (IIS常駐) で 80 が奪われるため、開発時は 19080 を使う
# 本番 Linux で 80 に戻したい場合はこの値を 80 に変更
WEB_PORT=19080
