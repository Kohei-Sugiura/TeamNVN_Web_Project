# PostgreSQL
POSTGRES_DB=nvn_database
POSTGRES_USER=nvn_operator
POSTGRES_PASSWORD=change_me_please

# 管理画面/API の Basic 認証
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change_me_admin_password

# nginx の外部公開ポート
# Windows (IIS常駐) で 80 が奪われるため、開発時は 19080 を使う
# 本番 Linux で 80 に戻したい場合はこの値を 80 に変更
WEB_PORT=19080

# SSL ポート (本番で 443 をそのまま使うなら未設定で OK)
# SSL_PORT=443

# Let's Encrypt 用 (deploy/setup-ssl.sh が参照)
# DOMAIN_NAME=teamnvn.example.com
# LETSENCRYPT_EMAIL=admin@example.com

# Discord Bot (4 つ全部セットしないと無効化される。空ならサイトは通常通り動く)
# - DISCORD_BOT_TOKEN: Developer Portal > Bot > Token
# - DISCORD_NOTIFY_CHANNEL_ID: 通知を流すチャンネルの ID (チャンネル右クリック > ID をコピー)
# - DISCORD_PUBLIC_KEY: Developer Portal > General Information > Public Key (hex)
# - DISCORD_APP_ID: Developer Portal > General Information > Application ID
# Interactions Endpoint URL は Developer Portal で
#   https://team-nvn-server.com/api/discord/interactions
# を設定する。
# DISCORD_BOT_TOKEN=
# DISCORD_NOTIFY_CHANNEL_ID=
# DISCORD_PUBLIC_KEY=
# DISCORD_APP_ID=

# Anthropic Claude API (リザルト画像からスコアを自動入力する機能で使用)
# 未設定なら /api/score/recognize は 503 を返し、スコアは手入力にフォールバック
# キーは https://console.anthropic.com/ から発行
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
